# Copy to .env and fill in. Docker Compose reads .env automatically;
# for commands run on your machine, use `uv run --env-file .env ...`.

# --- Secrets (needed from Phase 1 onwards) ---
# Claude API key, for the thesis agent (Phase 3).
ANTHROPIC_API_KEY=
# Key for the embedding provider, e.g. Voyage (Phase 2). Leave blank for a local model.
EMBEDDING_API_KEY=
# The SEC requires a User-Agent naming you and a contact email, or it blocks requests.
SEC_USER_AGENT="FilingThesisEngine your-name your-email@example.com"

# --- Database ---
# Used by code run on your machine. Inside Docker, Compose points the API at the db service instead.
DATABASE_URL=postgresql+psycopg://fte:fte@localhost:5432/fte
POSTGRES_USER=fte
POSTGRES_PASSWORD=fte
POSTGRES_DB=fte

# --- Ports on localhost ---
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
